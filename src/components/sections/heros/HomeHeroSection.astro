---
import { Icon } from 'astro-icon/components';
import { TextSection, Container, Button } from '@components/odyssey-theme';
import settings from '../../../config/settings.js';
import {ThemeSwitcher} from '../../theme-switcher/theme-switcher';
---

<Container narrow>
	<TextSection>
		<h2 style="text-align:center">Seafloor Explorer - Online Seminar Series</h2>
	</TextSection>
	<section class="hero-section__section">
		<div class="hero-section__text">
			<p>
			Dedicated to bring together UK/EU-based scientists working on ocean tectonic settings, 
			across disciplines including but not limited to geology, geophysics, geochemistry, marine geosciences.
		</p>
			<p>
				Seminars are hosted virtually at 3pm UK time on Tuesdays mid-month (once a month). 
			</p>
				<p>
					Sign up to the mailing list for updates and to register for seminars.
				</p>
				<div class="hero-btns__container">
					<Button href="https://www.jiscmail.ac.uk/cgi-bin/wa-jisc.exe?SUBED1=SEAFLOOR-EXPLORER&A=1" customIcon newTab
						>Join mailing list
            <Fragment slot="icon">
              <Icon name="ic:baseline-chevron-right"/>
            </Fragment>
            </Button>
					</div>
					<p></p>

						<p>
							To suggest speakers please fill the form below. 
						</p>
						<div class="hero-btns__container">
							<Button href="https://docs.google.com/forms/d/e/1FAIpQLSeXyoUFaV6iUfiO5yNHFVOBwJq94f062mlj2-GaVmHUnsLoQg/viewform?usp=header" newTab customIcon
								>Speaker suggestions
								<Fragment slot="icon">
									<Icon name="ic:baseline-chevron-right"/>
								</Fragment>
								</Button>
				</div>
		</div>
		<div class="hero-section__image">
				<picture>
					<img
						src="/assets/seafloor/social.jpeg"
						alt="seafloor"
						id="home-seafloor-image"
					/>
					<p style="text-align:center; font-size: var(--font-size-sm);">Ocean floor at the Paramount seamount. Credit: NOAA Okeanos Explorer Program</p>
				</picture>
		</div>
	</section>
</Container>

<style>
	.hero-section__section {
		margin: var(--section-margin) auto;
		min-height: clamp(90vh, 100vw, calc(100vh - var(--navbar-height)));
		display: grid;
		grid-template-columns: 55% 45%;
		align-items: center;
		gap: 1rem;
	}
	.hero-section__text {
		justify-self: center;
		max-width: 40rem;
	}
	.hero-btns__container {
		display: flex;
		align-items: center;
		gap: 1rem;
	}
	.hero-btns__container {
		margin-right: 1rem;
	}
	.hero-section__image {
		display: flex;
	}
	.hero-section__image img {
		width: 100%;
		height: 100%;
		max-height: 80vh;
		object-fit: cover;
		border-radius: var(--theme-shape-radius);
	}
	@media (max-width: 768px) {
		.hero-section__section {
			grid-template-columns: 1fr;
		}
	}
</style>