---
const {href, theme_title} = Astro.props;
---

<style>
  .feature-card-blank__card {
    background-color: var(--theme-surface-1);
    color: var(--theme-on-surface-1);
    border-radius: var(--theme-shape-radius);
  }
  .feature-card-blank__link {
    display: block;
    text-decoration: none;
  }
  .featured-card-blank__content {
    padding: 0.5rem 0.5rem 0.5rem 0.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow-y: hidden;
  }
  .feature-card-blank__title {
    font-family: var(--theme-font-family-sans);
  }
</style>

<div class="feature-card-blank__card">
  <a class="feature-card-blank__link" href={href}>
    <div class="featured-card-blank__content">
      <h3 style="text-align:center;" class="feature-card-blank__title">{theme_title}</h3>
    </div>
  </a>
</div> 