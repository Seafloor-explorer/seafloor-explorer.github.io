---
import { Container, FeatureCard } from '@components/odyssey-theme';

import Layout from '../layouts/Page.astro';
import HomeHeroSection from '../components/sections/heros/HomeHeroSection.astro';
import SeminarCard from '../components/cards/SeminarCard.astro';
import SeminarCard2 from '../components/cards/SeminarCard2.astro';
import SeminarCard_blank from '../components/cards/SeminarCard_blank.astro';
import settings from '../config/settings.js';
import {ThemeSwitcher} from '../components/theme-switcher/theme-switcher';
---

<Layout>
	<HomeHeroSection />

	<Container narrow>
		<section class="feature-card__section">
			<h2 style="text-align:center;">Upcoming meetings</h2>

			<div class="feature-card2__grid">
				<SeminarCard2
					href="/seafloor/seminar10" 
					theme_title="10. Advances in seafloor geodesy | April 14, 2026 at 15:00 BST"
					auth1="Andrew Newman (Georgia Tech, US)"
					title1="Extending GNSS-Acoustic seafloor geodetic methods to the very near trench region"
					auth2="Marc-André Gutscher (U. Brest, FR)"
					title2="Using fibre optic cables to detect movements at the seafloor"
				></SeminarCard2>
			</div>
			<p></p>
			<div class="feature-card-blank__grid">
				<SeminarCard_blank 
					href="/seafloor/seminar11" 
					theme_title="EGU26 Lunch meet-up | Austria Center Vienna, Terrasse K | Friday May 8, 2026 at 12:30 CET"
				></SeminarCard_blank>
			</div>
			<p></p>
			<div class="feature-card2__grid">
				<SeminarCard2 
					href="/seafloor/seminar11" 
					theme_title="11. The lithosphere-asthenosphere boundary and petit-spots | May 26, 2026 at 15:00 BST"
					auth1="Paola Vannucchi (U. Florence, IT)"
					title1="TBC"
					auth2="Sébastien Pilet (U. Lausanne, CH)"
					title2="TBC"
				></SeminarCard2>
			</div>
			<p></p>
			<div class="feature-card-blank__grid">
				<SeminarCard_blank 
					href="/seafloor/seminar12" 
					theme_title="12. Geophysics for off-shore engineering | June 16, 2026 at 15:00 BST"
				></SeminarCard_blank>
			</div>
			<p></p>

			<p></p>
			<h2 style="text-align:center;">Past meetings</h2>
			<p style="text-align:center;">* Click on each seminar to view recordings * </p>

			<div class="feature-card__grid">
				<SeminarCard 
					href="/seafloor/seminar9" 
					theme_title="9. Expedition reports - Iceland | March 17, 2026"
					auth1="Nick Rawlinson (U. Cambridge, UK)"
					title1="Seismicity and seismic imaging of volcanic rift zones in Iceland"
					auth2="Stephen Jones (U. Birmingham, UK)"
					title2="The IMPULSE experiment: New oceanic crustal record of thermal plume pulsing of Earth's strongest mantle plume"
					auth3="Jacqueline Dixon (U. South Florida, US)"
					title3="Upcoming Investigation of Small Seamounts in the Bight Volcanic Field and Challenges to the Pulsing Plume Model"
				></SeminarCard>
			</div>
			<p></p>

			<div class="feature-card__grid">
				<SeminarCard
					href="/seafloor/seminar8" 
					theme_title="8. Outreach and communication in marine geosciences | February 17, 2026"
					auth1="Jodie Fischer (IODP3, UK)"
					title1="Science Communication and Outreach in Scientific Ocean Drilling - an IODP3 perspective"
					auth2="Cory Hite (U. Delaware, US)"
					title2="Ship-to-Shore: Science outreach aboard research vessels"
					auth3="Milena Marjanovic (IPGP, FR)"
					title3="How do we make a scan of Earth's oceanic crust?"
				></SeminarCard>
			</div>
			<p></p>

			<div class="feature-card__grid">
				<SeminarCard 
					href="/seafloor/seminar7" 
					theme_title="7. Geophysical imagining of subduction zone structure and dynamics | January 13, 2026"
					auth1="Shawn Wei (Michigan State U., US)"
					title1="Slab dehydration and sub-arc melting beneath the Alaska Peninsula revealed by amphibious seismic observations"
					auth2="Eduardo Contreras-Reyes (U. Chile, CL)"
					title2="Seismic Structure and Tectonic Evolution of the Juan Fernández Ridge-South America Collision Zone"
					auth3="McKenzie Carlson (U. Texas at Austin, US)"
					title3="Triggered vs Spontaneous Slow Slip Events in the Hikurangi Subduction Zone"
				></SeminarCard>
			</div>
			<p></p>
			<div class="feature-card__grid">
				<SeminarCard
					href="/seafloor/seminar6" 
					theme_title="6. Transform faults as non-conservative plate boundaries | November 18, 2025"
					auth1="Jessica Warren (U. Delaware, US)"
					title1="The role of serpentine for creep at oceanic transform faults"
					auth2="Lars Rüpke (GEOMAR, DE)"
					title2="How faults, magma, and fluids shape the Oceanographer transform fault and its adjacent ridge segments"
					auth3="Hasbi Shiddiqi (KAUST, SA)"
					title3="Transform faulting in the Zabargad Fracture Zone, Northern Red Sea: Insights from ocean bottom seismometers"
				></SeminarCard>
			</div>
			<p></p>
			
			<div class="feature-card__grid">
				<SeminarCard 
					href="/seafloor/seminar5" 
					theme_title="5. Expedition reports - Caribbean/Americas | October 14, 2025"
					auth1="Frauke Klingelhoefer (IFREMER, FR)"
					title1="First results from the Manta-Ray deep seismic cruise in the Lesser Antilles"
					auth2="Jenny Collier (Imperial, UK)"
					title2="Volatile recycling at the Lesser Antilles subduction zone: How wet is the incoming plate?"
					auth3="Nicholas Harmon (WHOI, US)"
					title3="Seismic imaging of melt and fluid pathways in the Lesser Antilles subduction zone"
				></SeminarCard>
			</div>
			<p></p>
			<div class="feature-card__grid">
				<SeminarCard
					href="/seafloor/seminar4" 
					theme_title="4. Submarine fibre cable sensing | September 16, 2025"
					auth1="Giuseppe Marra (NPL, UK)"
					title1="Science with seafloor cables"
					auth2="James Lindsey (Güralp, UK)"
					title2="Science Monitoring And Reliable Telecommunications (“SMART”) Cables - A Successful Case Study Offshore Sicily and Future Opportunities"
					auth3="Afonso Loureiro (ARDITI, PT)"
					title3="Complementing marine geosciences with seafloor distributed sensors"
				></SeminarCard>
			</div>
			<p></p>
				<div class="feature-card__grid">
				<SeminarCard 
					href="/seafloor/seminar3" 
					theme_title="3. Submarine hazards: earthquakes, eruptions, landslides | August 19, 2025"
					auth1="Mike Clare (NOC, UK)"
					title1="Unexpected offshore hazards and sediment fluxes resulting from ocean-entering lahars"
					auth2="Erin Wirth (USGS, US)"
					title2="Earthquakes and Cascading Hazards in the Cascadia Subduction Zone"
					auth3="Sebastian Watt (U. Birmingham, UK)"
					title3="Hazards from unstable volcanic-island flanks: new insights from historical events"
				></SeminarCard>
			</div>
			<p></p>
			<div class="feature-card__grid">
				<SeminarCard 
					href="/seafloor/seminar2" 
					theme_title="2. Melt pathways at mid-ocean ridges | July 15, 2025"
					auth1="Jean-Arthur Olive (CNRS, FR)"
					title1="Should I Dike or Should I Fault: a Mid-Ocean Ridge Dilemma"
					auth2="Milena Marjanovic (IPGP, FR)"
					title2="Up-close with the Magma Bodies and Eruption Dynamics at the East Pacific Rise 9N"
					auth3="Zhikai Wang (U. Southampton, UK / IPGP, FR)"
					title3="Seismic evidence for upper crustal accretion by long-distance lateral dyke injection at the Lucky Strike segment of Mid-Atlantic Ridge"
				></SeminarCard>
			</div>
			<p></p>
			<div class="feature-card__grid">
				<SeminarCard 
					href="/seafloor/seminar1" 
					theme_title="1. Recent expedition reports - Santorini | June 17, 2025"
					auth1="Jonas Preine (WHOI, US)"
					title1="Discovery of a major submarine eruption of Santorini in historic times"
					auth2="Michele Paulatto (Imperial College London, UK)"
					title2="Seismic imaging of the Santorini volcanic system"
					auth3="Jens Karstens (GEOMAR, DE)"
					title3="Marine geophysical insights into the 2025 Santorini volcano-tectonic crisis"
				></SeminarCard>
			</div>
			<p></p>

		</section>
		<!-- {settings.enableThemeSwitcher && <ThemeSwitcher client:only/>} -->
	</Container>

</Layout>

<style>
	.feature-card__section {
		margin: var(--section-margin) auto;
	}
	.feature-card__grid {
		display: grid;
		/* grid-template-columns: repeat(2, 1fr); */
		gap: var(--theme-grid-gap);
	}
	@media (max-width: 768px) {
		.feature-card__grid {
			grid-template-columns: 1fr;
		}
	}
</style>
