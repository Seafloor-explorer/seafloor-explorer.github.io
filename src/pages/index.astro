---
import { Container, FeatureCard } from '@components/odyssey-theme';

import Layout from '../layouts/Page.astro';
import HomeHeroSection from '../components/sections/heros/HomeHeroSection.astro';
import SeminarCard from '../components/cards/SeminarCard.astro';
import SeminarCard_blank from '../components/cards/SeminarCard_blank.astro';
import settings from '../config/settings.js';
import {ThemeSwitcher} from '../components/theme-switcher/theme-switcher';
---

<Layout>
	<HomeHeroSection />

	<Container narrow>
		<section class="feature-card__section">
			<h2 style="text-align:center;">Upcoming meetings</h2>

			<div class="feature-card__grid">
				<SeminarCard
					href="/seafloor/seminar4" 
					theme_title="4. Submarine fibre cable sensing | September 16, 2025 at 15:00 BST"
					auth1="Giuseppe Marra (NPL, UK)"
					title1="Science with seafloor cables"
					auth2="James Lindsey (Güralp, UK)"
					title2="Science Monitoring And Reliable Telecommunications (“SMART”) Cables - A Successful Case Study Offshore Sicily and Future Opportunities"
					auth3="Afonso Loureiro (ARDITI, PT)"
					title3="Complementing marine geosciences with seafloor distributed sensors"
				></SeminarCard>
			</div>
			<p></p>
			<div class="feature-card-blank__grid">
				<SeminarCard_blank 
					href="/seafloor/seminar5" 
					theme_title="5. Recent expedition reports - Caribbean/Americas | October 14, 2025 at 15:00 BST"
				></SeminarCard_blank>
			</div>
			<p></p>
			<div class="feature-card-blank__grid">
				<SeminarCard_blank 
					href="/seafloor/seminar6" 
					theme_title="6. Transform faults as non-conservative plate boundaries | November 18, 2025 at 15:00 GMT"
				></SeminarCard_blank>
			</div>
			<p></p>

			<p></p>
			<h2 style="text-align:center;">Past meetings</h2>
			<p style="text-align:center;">* Click on each seminar to view recordings * </p>

				<div class="feature-card__grid">
				<SeminarCard 
					href="/seafloor/seminar3" 
					theme_title="3. Submarine hazards: earthquakes, eruptions, landslides | August 19, 2025"
					auth1="Mike Clare (NOC, UK)"
					title1="Unexpected offshore hazards and sediment fluxes resulting from ocean-entering lahars"
					auth2="Erin Wirth (USGS, US)"
					title2="Earthquakes and Cascading Hazards in the Cascadia Subduction Zone"
					auth3="Sebastian Watt (U. Birmingham, UK)"
					title3="Hazards from unstable volcanic-island flanks: new insights from historical events"
				></SeminarCard>
			</div>
			<p></p>
			<div class="feature-card__grid">
				<SeminarCard 
					href="/seafloor/seminar2" 
					theme_title="2. Melt pathways at mid-ocean ridges | July 15, 2025"
					auth1="Jean-Arthur Olive (CNRS, FR)"
					title1="Should I Dike or Should I Fault: a Mid-Ocean Ridge Dilemma"
					auth2="Milena Marjanovic (IPGP, FR)"
					title2="Up-close with the Magma Bodies and Eruption Dynamics at the East Pacific Rise 9N"
					auth3="Zhikai Wang (U. Southampton, UK / IPGP, FR)"
					title3="Seismic evidence for upper crustal accretion by long-distance lateral dyke injection at the Lucky Strike segment of Mid-Atlantic Ridge"
				></SeminarCard>
			</div>
			<p></p>
			<div class="feature-card__grid">
				<SeminarCard 
					href="/seafloor/seminar1" 
					theme_title="1. Recent expedition reports - Santorini | June 17, 2025"
					auth1="Jonas Preine (WHOI, US)"
					title1="Discovery of a major submarine eruption of Santorini in historic times"
					auth2="Michele Paulatto (Imperial College London, UK)"
					title2="Seismic imaging of the Santorini volcanic system"
					auth3="Jens Karstens (GEOMAR, DE)"
					title3="Marine geophysical insights into the 2025 Santorini volcano-tectonic crisis"
				></SeminarCard>
			</div>
			<p></p>

		</section>
		<!-- {settings.enableThemeSwitcher && <ThemeSwitcher client:only/>} -->
	</Container>

</Layout>

<style>
	.feature-card__section {
		margin: var(--section-margin) auto;
	}
	.feature-card__grid {
		display: grid;
		/* grid-template-columns: repeat(2, 1fr); */
		gap: var(--theme-grid-gap);
	}
	@media (max-width: 768px) {
		.feature-card__grid {
			grid-template-columns: 1fr;
		}
	}
</style>
