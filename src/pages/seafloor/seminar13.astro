---
import { 
	Container, 
	Button,
  TextCardSection,
	YouTubeEmbedSection, 
  TextSection } from '@components/odyssey-theme';
import Layout from '../../layouts/Page.astro';
import TextAndImageHero from '../../components/sections/heros/TextAndImageHero.astro';

const seo = {
  title: `Seminar 13 | Seafloor Explorer`,
  description: `Expedition reports - Pacific`,
};
---

<Layout seo={seo}>
	<TextSection narrow>
			<h2>13. Expedition reports - Pacific </h2>
      <h4>Live: July 14, 2026 at 15:00 BST</h4> 
      Sign up to the mailing list for updates and to register for seminars. Registration link also available in the <a target="_blank" href="https://calendar.google.com/calendar/embed?height=600&wkst=1&ctz=Europe%2FLondon&showPrint=0&src=Zjk4ZGU5ZGVmNDBhMGNjYTRlNzM1NTQ3ZTNhZmQzYjFhN2U4ZThkYTczMmVlZjZkODIwYTQ0NzQxNDBjNjMzY0Bncm91cC5jYWxlbmRhci5nb29nbGUuY29t&color=%23ad1457https://calendar.google.com/calendar/embed?height=600&wkst=2&ctz=Europe%2FLondon&showPrint=0&mode=AGENDA&src=Zjk4ZGU5ZGVmNDBhMGNjYTRlNzM1NTQ3ZTNhZmQzYjFhN2U4ZThkYTczMmVlZjZkODIwYTQ0NzQxNDBjNjMzY0Bncm91cC5jYWxlbmRhci5nb29nbGUuY29t&color=%23ad1457">calendar</a>.
    </TextSection>

   <TextSection narrow>
    <h3>TORRRTUGA: Triple-junction OBS Ridge-Ridge-Ridge Tomography of Upwelling Galápagos Asthenosphere - Experiment and deployment report</h3>
    <h4><a target="_blank" href="https://zeilon.squarespace.com">Zach Eilon</a>, University of California Santa Barbara, US</h4>
    <!-- <p>
      <em>Abstract:</em> Lorem Ipsum 
    </p> -->
    <YouTubeEmbedSection url="https://www.youtube.com/watch?v=DX-RWY_L_XI" rounded/>

    <p></p>
    
    <h3>Magnetotelluric imaging of fluid in the Gofar fault zone, East Pacific Rise</h3>
    <h4><a target="_blank" href="https://www.whoi.edu/profile/natalie.hummel/">Natalie Hummel</a>, Woods Hole Oceanographic Institution, US</h4>
    <!-- <p>
      <em>Abstract:</em> Lorem Ipsum 
    </p> -->
    <YouTubeEmbedSection url="https://www.youtube.com/watch?v=e0dMVPz_BNE" rounded/>

    <p></p>

  </TextSection>

      <TextSection narrow>
			<div class="cta-buttons__container">
				<Button href="/">Return Home</Button>
			</div>
    </TextSection>
</Layout>

<style>
	.cta-buttons__container {
		display: flex;
		flex-wrap: wrap;
	}
	.cta-buttons__container :global(a) {
		margin-right: 1rem;
		margin-bottom: 1rem;
	}
	.code-buttons__container {
		margin: 1rem auto;
		display: flex;
		flex-wrap: wrap;
	}
	.code-buttons__container > a {
		margin-right: 1rem;
		margin-bottom: 1rem;
	}
</style>
