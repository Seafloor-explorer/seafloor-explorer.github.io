---
import { 
	Container, 
	Button,
  TextCardSection,
	YouTubeEmbedSection, 
  TextSection } from '@components/odyssey-theme';
import Layout from '../../layouts/Page.astro';
import TextAndImageHero from '../../components/sections/heros/TextAndImageHero.astro';

const seo = {
  title: `Seminar 2 | Seafloor Explorer`,
  description: `Melt pathways at mid-ocean ridges`,
};
---

<Layout seo={seo}>
	<TextSection narrow>
			<h2>2. Melt pathways at mid-ocean ridges</h2>
      <h4>Live: July 15, 2025 at 15:00 BST</h4> 
      Sign up to the mailing list for updates and to register for seminars. Registration link also available in the <a target="_blank" href="https://calendar.google.com/calendar/embed?height=600&wkst=1&ctz=Europe%2FLondon&showPrint=0&src=Zjk4ZGU5ZGVmNDBhMGNjYTRlNzM1NTQ3ZTNhZmQzYjFhN2U4ZThkYTczMmVlZjZkODIwYTQ0NzQxNDBjNjMzY0Bncm91cC5jYWxlbmRhci5nb29nbGUuY29t&color=%23ad1457https://calendar.google.com/calendar/embed?height=600&wkst=2&ctz=Europe%2FLondon&showPrint=0&mode=AGENDA&src=Zjk4ZGU5ZGVmNDBhMGNjYTRlNzM1NTQ3ZTNhZmQzYjFhN2U4ZThkYTczMmVlZjZkODIwYTQ0NzQxNDBjNjMzY0Bncm91cC5jYWxlbmRhci5nb29nbGUuY29t&color=%23ad1457">calendar</a>.
      <!-- <p>*** Recordings to be uploaded after the live seminar ***</p> -->
    </TextSection>

    <TextSection narrow>
    <h3>Should I Dike or Should I Fault: a Mid-Ocean Ridge Dilemma</h3>
    <h4><a target="_blank" href="https://jaolive.weebly.com">Jean-Arthur Olive</a>, CNRS/ENS, France</h4>
    <!-- <p>
      <em>Abstract:</em> Lorem Ipsum 
    </p> -->
    <YouTubeEmbedSection url="https://www.youtube.com/watch?v=vuROpG6EMNg&t=15s" rounded/>

    <p></p>

    <h3>Up-close with the Magma Bodies and Eruption Dynamics at the East Pacific Rise 9N</h3>
    <h4><a target="_blank" href="https://scholar.google.com/citations?user=pxDPN4MAAAAJ&hl=en">Milena Marjanovic</a>, CNRS/IPGP, France</h4>
    <!-- <p>
      <em>Abstract:</em> Lorem Ipsum 
    </p> -->
    <YouTubeEmbedSection url="https://www.youtube.com/watch?v=RuYS-Q-kDXs" rounded/>

    <p></p>

    <h3>Seismic evidence for upper crustal accretion by long-distance lateral dyke injection at the Lucky Strike segment of Mid-Atlantic Ridge</h3>
    <h4><a target="_blank" href="https://zhikaiwang1992.github.io">Zhikai Wang</a>, U. Southampton, UK / IPGP, France</h4>
    <!-- <p>
      <em>Abstract:</em> Lorem Ipsum 
    </p> -->
    <YouTubeEmbedSection url="https://www.youtube.com/watch?v=v6_856WuHWk" rounded/>

  </TextSection>

      <!-- <TextAndImageHero>
        <div slot="text-container">

        </div>
        <picture slot="image-container">
          <YouTubeEmbedSection url="https://www.youtube.com/watch?v=hoBybmiXkzs" rounded/>
        </picture>
      </TextAndImageHero> -->

      <TextSection narrow>
			<div class="cta-buttons__container">
				<Button href="/">Return Home</Button>
			</div>
    </TextSection>
</Layout>

<style>
	.cta-buttons__container {
		display: flex;
		flex-wrap: wrap;
	}
	.cta-buttons__container :global(a) {
		margin-right: 1rem;
		margin-bottom: 1rem;
	}
	.code-buttons__container {
		margin: 1rem auto;
		display: flex;
		flex-wrap: wrap;
	}
	.code-buttons__container > a {
		margin-right: 1rem;
		margin-bottom: 1rem;
	}
</style>
