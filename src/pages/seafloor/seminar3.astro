---
import { 
	Container, 
	Button,
  TextCardSection,
	YouTubeEmbedSection, 
  TextSection } from '@components/odyssey-theme';
import Layout from '../../layouts/Page.astro';
import TextAndImageHero from '../../components/sections/heros/TextAndImageHero.astro';

const seo = {
  title: `Seminar 3 | Seafloor Explorer`,
  description: `Seminar 3`,
};
---

<Layout seo={seo}>
	<TextSection narrow>
			<h2>3. Submarine hazards: earthquakes, eruptions, landslides</h2>
      <h4>Live: August 19, 2025 at 15:00 BST</h4> 
      Sign up to the mailing list for updates and to register for seminars. Registration link also available in the <a target="_blank" href="https://calendar.google.com/calendar/embed?height=600&wkst=1&ctz=Europe%2FLondon&showPrint=0&src=Zjk4ZGU5ZGVmNDBhMGNjYTRlNzM1NTQ3ZTNhZmQzYjFhN2U4ZThkYTczMmVlZjZkODIwYTQ0NzQxNDBjNjMzY0Bncm91cC5jYWxlbmRhci5nb29nbGUuY29t&color=%23ad1457https://calendar.google.com/calendar/embed?height=600&wkst=2&ctz=Europe%2FLondon&showPrint=0&mode=AGENDA&src=Zjk4ZGU5ZGVmNDBhMGNjYTRlNzM1NTQ3ZTNhZmQzYjFhN2U4ZThkYTczMmVlZjZkODIwYTQ0NzQxNDBjNjMzY0Bncm91cC5jYWxlbmRhci5nb29nbGUuY29t&color=%23ad1457">calendar</a>.
    </TextSection>

    <TextSection narrow>
    <h3>Unexpected offshore hazards and sediment fluxes resulting from ocean-entering lahars</h3>
    <h4><a target="_blank" href="https://noc.ac.uk/n/Mike%20Clare">Mike Clare</a>, National Oceanography Centre, UK</h4>
    <!-- <p>
      <em>Abstract:</em> Lorem Ipsum 
    </p> -->
    <YouTubeEmbedSection url="https://www.youtube.com/watch?v=LDVencGtKPs" rounded/>

    <p></p>

    <h3>Earthquakes and Cascading Hazards in the Cascadia Subduction Zone</h3>
    <h4><a target="_blank" href="https://www.usgs.gov/staff-profiles/erin-wirth-moriarty">Erin Wirth</a>, US Geological Survey, USA</h4>
    <p>*** Link to recording can be provided on request by <a target="_blank" href="mailto:adina.pusok@earth.ox.ac.uk">emailing</a> the organisers. ***</p>
    <!-- <p>
      <em>Abstract:</em> Lorem Ipsum 
    </p> -->
    <!-- <YouTubeEmbedSection url="https://www.youtube.com/watch?v=hoBybmiXkzs" rounded/> -->

    <p></p>

    <h3>Hazards from unstable volcanic-island flanks: new insights from historical events</h3>
    <h4><a target="_blank" href="https://www.birmingham.ac.uk/staff/profiles/gees/watt-sebastian">Sebastian Watt</a>, U. Birmingham, UK</h4>
    <!-- <p>
      <em>Abstract:</em> Lorem Ipsum 
    </p> -->
    <YouTubeEmbedSection url="https://www.youtube.com/watch?v=a32bGH9C5Pk" rounded/>

  </TextSection>


      <TextSection narrow>
			<div class="cta-buttons__container">
				<Button href="/">Return Home</Button>
			</div>
    </TextSection>
</Layout>

<style>
	.cta-buttons__container {
		display: flex;
		flex-wrap: wrap;
	}
	.cta-buttons__container :global(a) {
		margin-right: 1rem;
		margin-bottom: 1rem;
	}
	.code-buttons__container {
		margin: 1rem auto;
		display: flex;
		flex-wrap: wrap;
	}
	.code-buttons__container > a {
		margin-right: 1rem;
		margin-bottom: 1rem;
	}
</style>
