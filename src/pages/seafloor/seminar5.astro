---
import { 
	Container, 
	Button,
  TextCardSection,
	YouTubeEmbedSection, 
  TextSection } from '@components/odyssey-theme';
import Layout from '../../layouts/Page.astro';
import TextAndImageHero from '../../components/sections/heros/TextAndImageHero.astro';

const seo = {
  title: `Seminar 5 | Seafloor Explorer`,
  description: `Expedition reports - Caribbean/Americas`,
  image: `seminar5_img.jpg`,
};
---

<Layout seo={seo}>
	<TextSection narrow>
			<h2>5. Expedition reports - Caribbean/Americas</h2>
      <h4>Live: October 14, 2025 at 15:00 BST</h4> 
      Sign up to the mailing list for updates and to register for seminars. Registration link also available in the <a target="_blank" href="https://calendar.google.com/calendar/embed?height=600&wkst=1&ctz=Europe%2FLondon&showPrint=0&src=Zjk4ZGU5ZGVmNDBhMGNjYTRlNzM1NTQ3ZTNhZmQzYjFhN2U4ZThkYTczMmVlZjZkODIwYTQ0NzQxNDBjNjMzY0Bncm91cC5jYWxlbmRhci5nb29nbGUuY29t&color=%23ad1457https://calendar.google.com/calendar/embed?height=600&wkst=2&ctz=Europe%2FLondon&showPrint=0&mode=AGENDA&src=Zjk4ZGU5ZGVmNDBhMGNjYTRlNzM1NTQ3ZTNhZmQzYjFhN2U4ZThkYTczMmVlZjZkODIwYTQ0NzQxNDBjNjMzY0Bncm91cC5jYWxlbmRhci5nb29nbGUuY29t&color=%23ad1457">calendar</a>.
    </TextSection>

   <TextSection narrow>
    <h3>First results from the Manta-Ray deep seismic cruise in the Lesser Antilles</h3>
    <h4><a target="_blank" href="https://annuaire.ifremer.fr/cv/16813/">Frauke Klingelhoefer</a>, IFREMER, France</h4>
    <!-- <p>
      <em>Abstract:</em> Lorem Ipsum 
    </p> -->
    <YouTubeEmbedSection url="https://www.youtube.com/watch?v=j6LNHqeflQo" rounded/>

    <p></p>

    <h3>Volatile recycling at the Lesser Antilles subduction zone: How wet is the incoming plate?</h3>
    <h4><a target="_blank" href="https://profiles.imperial.ac.uk/jenny.collier">Jenny Collier</a>, Imperial College London, UK</h4>
    <!-- <p>
      <em>Abstract:</em> Lorem Ipsum 
    </p> -->
    <YouTubeEmbedSection url="https://www.youtube.com/watch?v=WjWLzsj9QWs" rounded/>

    <p></p>

    <h3>Seismic imaging of melt and fluid pathways in the Lesser Antilles subduction zone</h3>
    <h4><a target="_blank" href="https://directory.whoi.edu/profile/nicholas-harmon/">Nicholas Harmon</a>, WHOI, US</h4>
    <!-- <p>
      <em>Abstract:</em> Lorem Ipsum 
    </p> -->
    <YouTubeEmbedSection url="https://www.youtube.com/watch?v=aEYtase95Is" rounded/>

  </TextSection>

      <TextSection narrow>
			<div class="cta-buttons__container">
				<Button href="/">Return Home</Button>
			</div>
    </TextSection>
</Layout>

<style>
	.cta-buttons__container {
		display: flex;
		flex-wrap: wrap;
	}
	.cta-buttons__container :global(a) {
		margin-right: 1rem;
		margin-bottom: 1rem;
	}
	.code-buttons__container {
		margin: 1rem auto;
		display: flex;
		flex-wrap: wrap;
	}
	.code-buttons__container > a {
		margin-right: 1rem;
		margin-bottom: 1rem;
	}
</style>
