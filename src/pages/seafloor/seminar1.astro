---
import { 
	Container, 
	Button,
  TextCardSection,
	YouTubeEmbedSection, 
  TextSection } from '@components/odyssey-theme';
import Layout from '../../layouts/Page.astro';
import TextAndImageHero from '../../components/sections/heros/TextAndImageHero.astro';

const seo = {
  title: `Seminar 1 | Seafloor Explorer`,
  description: `Seminar 1`,
};
---

<Layout seo={seo}>
	<TextSection narrow>
			<h2>1. Recent expedition reports - Santorini</h2>
      <h4>Live: June 17, 2025 at 15:00 BST</h4> 
      Sign up to the mailing list for updates and to register for seminars.
      <p>*** Recordings to be uploaded after the live seminar ***</p>
    </TextSection>

    <TextSection narrow>
    <h3>Discovery of a major submarine eruption of Santorini in historic times</h3>
    <h4><a target="_blank" href="https://directory.whoi.edu/profile/jonas-preine/">Jonas Preine</a>, Woods Hole Oceanographic Institution, USA</h4>
